// penambahan validasi kuota dan saldo

class Tiket(
    val namaTiket: String,
    val harga: Double,
    kuotaAwal: Int
) {
    var kuota: Int = kuotaAwal
        private set

    fun kurangiKuota() {
        if (kuota > 0) kuota--
    }

    fun infoTiket() {
        println("  [INFO] Tiket: $namaTiket | Harga: Rp$harga | Sisa Kuota: $kuota")
    }
}

class Pembeli(val nama: String, saldoAwal: Double) {
    var saldo: Double = saldoAwal
        private set

    fun bayar(jumlah: Double) {
        if (saldo >= jumlah) saldo -= jumlah
    }

    fun infoSaldo() {
        println("  [INFO] Saldo $nama: Rp$saldo")
    }
}

class Panitia(val namaPanitia: String) {
    fun prosesPembelian(pembeli: Pembeli, tiket: Tiket) {
        println("\n--- ${pembeli.nama} mencoba membeli '${tiket.namaTiket}' ---")

        // Validasi 1: Cek kuota
        if (tiket.kuota <= 0) {
            println("❌ GAGAL: Tiket '${tiket.namaTiket}' sudah SOLD OUT!")
            return
        }

        // Validasi 2: Cek saldo
        if (pembeli.saldo < tiket.harga) {
            println("❌ GAGAL: Saldo ${pembeli.nama} tidak mencukupi. (Butuh: Rp${tiket.harga} | Saldo: Rp${pembeli.saldo})")
            return
        }

        // Eksekusi transaksi
        pembeli.bayar(tiket.harga)
        tiket.kurangiKuota()
        println("✅ SUKSES: ${pembeli.nama} berhasil membeli tiket '${tiket.namaTiket}'!")
        println("   Sisa Saldo: Rp${pembeli.saldo} | Sisa Kuota: ${tiket.kuota}")
    }
}

fun main() {
    val tiketRegul = Tiket("Konser BEM Reguler", 100000.0, 1)
    val budi = Pembeli("Budi", 300000.0)
    val sari = Pembeli("Sari", 50000.0)
    val panitia = Panitia("Rubian")

    println("=== SIMULASI TICKETING EVENT BEM ITK ===")
    tiketRegul.infoTiket()

    // Skenario 1: SUKSES
    panitia.prosesPembelian(budi, tiketRegul)

    // Skenario 2: GAGAL - Sold Out
    panitia.prosesPembelian(sari, tiketRegul)

    // Skenario 3: GAGAL - Saldo kurang
    val tiketVIP = Tiket("Konser BEM VIP", 250000.0, 3)
    panitia.prosesPembelian(sari, tiketVIP)
}
