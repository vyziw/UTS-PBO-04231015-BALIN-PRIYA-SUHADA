// penambahan fitur kode promo

import java.time.LocalDate

class Tiket(
    val namaTiket: String,
    val harga: Double,
    kuotaAwal: Int,
    private val kodePromoValid: String,
    private val tanggalKadaluarsa: LocalDate
) {
    var kuota: Int = kuotaAwal
        private set

    fun verifikasiPromo(kodeInput: String, tanggalBeli: LocalDate): Boolean {
        if (kodeInput != kodePromoValid) return false
        if (tanggalBeli.isAfter(tanggalKadaluarsa)) return false
        return true
    }

    fun kurangiKuota(hargaBayar: Double) {
        if (kuota > 0) kuota--
    }

    fun infoTiket() {
        println("  [INFO] Tiket: $namaTiket | Harga: Rp$harga | Sisa Kuota: $kuota")
    }
}

class Pembeli(val nama: String, saldoAwal: Double) {
    var saldo: Double = saldoAwal
        private set

    fun bayar(jumlah: Double) {
        if (saldo >= jumlah) saldo -= jumlah
    }

    fun infoSaldo() {
        println("  [INFO] Saldo $nama: Rp$saldo")
    }
}

class Panitia(val namaPanitia: String) {
    fun prosesPembelian(
        pembeli: Pembeli,
        tiket: Tiket,
        kodePromoInput: String,
        tanggalBeli: LocalDate
    ) {
        println("\n--- ${pembeli.nama} mencoba membeli '${tiket.namaTiket}' ---")

        // Validasi 1: Cek kuota
        if (tiket.kuota <= 0) {
            println("❌ GAGAL: Tiket '${tiket.namaTiket}' sudah SOLD OUT!")
            return
        }

        // Validasi 2: Cek kode promo jika diinput
        val hargaFinal: Double
        if (kodePromoInput.isNotEmpty()) {
            val promoSah = tiket.verifikasiPromo(kodePromoInput, tanggalBeli)
            if (!promoSah) {
                println("❌ GAGAL: Kode promo '$kodePromoInput' tidak valid atau sudah kadaluarsa!")
                return
            }
            hargaFinal = tiket.harga * 0.8
            println("  ✔ Kode promo valid! Diskon 20% diterapkan.")
        } else {
            hargaFinal = tiket.harga
        }

        // Validasi 3: Cek saldo
        if (pembeli.saldo < hargaFinal) {
            println("❌ GAGAL: Saldo ${pembeli.nama} tidak mencukupi. (Butuh: Rp$hargaFinal | Saldo: Rp${pembeli.saldo})")
            return
        }

        // Eksekusi transaksi
        pembeli.bayar(hargaFinal)
        tiket.kurangiKuota(hargaFinal)
        println("✅ SUKSES: ${pembeli.nama} berhasil membeli tiket '${tiket.namaTiket}'!")
        println("   Harga Dibayar: Rp$hargaFinal | Sisa Saldo: Rp${pembeli.saldo} | Sisa Kuota: ${tiket.kuota}")
    }
}

fun main() {
    val hariIni      = LocalDate.of(2026, 4, 23)
    val promoExpired = LocalDate.of(2026, 4, 20)

    val tiketVIP    = Tiket("Konser BEM VIP", 250000.0, 2, "BEM2026", LocalDate.of(2026, 5, 1))
    val tiketVIPExp = Tiket("Konser BEM VIP Expired", 250000.0, 2, "BEM2026", promoExpired)
    val sari        = Pembeli("Sari", 200000.0)
    val panitia     = Panitia("Rubian")

    println("=== SIMULASI TICKETING EVENT BEM ITK ===")

    // Skenario: GAGAL - kode promo salah
    panitia.prosesPembelian(sari, tiketVIP, "SALAH123", hariIni)

    // Skenario: GAGAL - kode promo kadaluarsa
    panitia.prosesPembelian(sari, tiketVIPExp, "BEM2026", hariIni)

    // Skenario: SUKSES - promo valid, diskon 20%
    panitia.prosesPembelian(sari, tiketVIP, "BEM2026", hariIni)
}
